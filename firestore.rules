rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasRole(roles) { return signedIn() && request.auth.token.role in roles; }
    function isAdmin() { return hasRole(['super_admin', 'admin']); }
    function isEditorial() { return hasRole(['super_admin', 'admin', 'editor', 'moderator']); }

    match /charityCases/{caseId} {
      allow read: if resource.data.status == 'published' || isEditorial();
      allow create: if isEditorial()
        && request.resource.data.get('receivedAmount', 0) == 0;
      allow update: if isEditorial()
        && request.resource.data.get('receivedAmount', 0) == resource.data.get('receivedAmount', 0);
      allow delete: if isAdmin();

      match /updates/{updateId} {
        allow read: if get(/databases/$(database)/documents/charityCases/$(caseId)).data.status == 'published' || isEditorial();
        allow write: if isEditorial();
      }

      match /supportTransactions/{transactionId} {
        allow read: if get(/databases/$(database)/documents/charityCases/$(caseId)).data.status == 'published' || isEditorial();
        allow write: if false;
      }
    }

    match /settings/categories {
      allow read: if true;
      allow create, update: if isEditorial();
      allow delete: if false;
    }

    match /settings/priorities {
      allow read: if true;
      allow create, update: if isEditorial();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['fullName', 'displayName', 'phone', 'email', 'role', 'status', 'balance', 'createdAt', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.balance == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;

      match /savedCases/{caseId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['caseId', 'savedAt'])
          && request.resource.data.caseId == caseId
          && request.resource.data.savedAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if false;
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /pushTokens/{tokenId} {
        allow read: if false;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'provider', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() < 4096
          && request.resource.data.provider in ['expo', 'fcm']
          && request.resource.data.platform in ['ios', 'android', 'web']
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /reports/{reportId} {
      allow create: if true;
      allow read, update: if hasRole(['super_admin', 'admin', 'moderator']);
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /consentRecords/{recordId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
