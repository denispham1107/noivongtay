rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isEditorial() {
      return signedIn() && request.auth.token.role in ['super_admin', 'admin', 'editor', 'moderator'];
    }
    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /public/cases/{caseId}/{fileName} {
      allow read: if true;
      allow create, update: if isEditorial() && validImage();
      allow delete: if isEditorial();
    }
    match /private/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.token.role in ['super_admin', 'admin'];
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
